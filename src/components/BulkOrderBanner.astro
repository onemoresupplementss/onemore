---
// Bulk-order banner on the homepage. The button opens WhatsApp on
// whatsappNumber from shop.config.json.
import { waHref } from '../lib/site.js';

const waLink = waHref("Hi oneMore, I'd like to place a bulk order.");
---

<section class="mx-auto max-w-7xl px-4 py-6" aria-labelledby="bulk-h">
  <div class="card relative overflow-hidden border-lime/40 p-6 sm:p-8">
    <div class="pointer-events-none absolute -right-24 -top-24 size-72 rounded-full bg-lime/10 blur-3xl" aria-hidden="true"></div>

    <div class="relative flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <div class="max-w-2xl">
        <p class="mb-2 text-xs font-bold uppercase tracking-[0.25em] text-lime">Bulk orders · Gyms &amp; trainers</p>
        <h2 id="bulk-h" class="display text-2xl sm:text-3xl">Buying in bulk?</h2>
        <p class="mt-3 text-muted">
          WhatsApp us at least <strong class="whitespace-nowrap text-white">2 business days</strong> before you need it.
          Home delivery in <strong class="whitespace-nowrap text-white">1–2 business days</strong>.
        </p>
        <p class="mt-1 text-sm text-muted">
          மொத்த ஆர்டர்களுக்கு 2 வேலை நாட்களுக்கு முன் WhatsApp-ல் தெரிவிக்கவும். 1–2 வேலை நாட்களில் வீட்டுக்கு டெலிவரி.
        </p>
      </div>

      <a
        href={waLink}
        target="_blank"
        rel="noopener"
        class="group inline-flex shrink-0 items-center justify-between gap-3.5 rounded-full bg-lime py-2 pl-6 pr-2 text-base font-extrabold whitespace-nowrap text-ink shadow-[0_10px_30px_-10px_rgba(198,255,0,0.6)] transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_16px_40px_-10px_rgba(198,255,0,0.75)] md:justify-start"
      >
        WhatsApp for bulk order
        <span class="grid size-10 place-items-center rounded-full bg-ink text-[#25d366] transition-transform duration-300 group-hover:-rotate-12 group-hover:scale-110">
          <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.8 0-1.4.7-2 1-2.3.2-.3.6-.3.8-.3h.6c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6-.4.4c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1c.2-.3.4-.2.6-.1l1.9.9c.3.1.5.2.5.3.1.2.1.6-.1 1.2Z"></path>
          </svg>
        </span>
      </a>
    </div>
  </div>
</section>
