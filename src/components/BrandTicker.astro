---
// "Brands we stock" as a stock-market ticker tape. Featured brands (shop.config.json
// "brandStrip") scroll in look-alike logo fonts; every other brand rides a thin tape below.
// Hover slows it to a stop, drag or swipe scrubs it, keyboard focus pauses it.
// Counts come from the catalogue; in checkout mode it also shows live "from" prices.
import { SHOW_PRICES, asset, url } from '../lib/env.js';
import { catalog, shop } from '../lib/site.js';
import { BRAND_FONTS, brandDisplay, brandFontFile, brandSlug } from '../lib/brand-fonts.js';
import { formatINR } from '../shared/order.js';

const byBrand = new Map();
for (const p of catalog.products) byBrand.set(p.brand, [...(byBrand.get(p.brand) || []), p]);

// Exchange-style symbol: initials (ON, KL), inner capitals (MB, MT) or the first four letters.
function symbol(name) {
  const words = name.replace(/[^A-Za-z0-9 ]/g, '').split(/\s+/).filter(Boolean);
  if (words.length > 1) return words.map((w) => w[0]).join('').toUpperCase().slice(0, 4);
  const caps = name.match(/[A-Z]/g) || [];
  if (caps.length > 1 && caps.length < name.length) return caps.join('').slice(0, 4);
  return name.toUpperCase().slice(0, 4);
}

function quote(name) {
  const products = byBrand.get(name);
  const variants = products.flatMap((p) => p.variants);
  const inStock = variants.filter((v) => v.stock > 0);
  const prices = (inStock.length ? inStock : variants).map((v) => v.price).filter((n) => n > 0);
  return {
    name,
    href: url(`/shop/?brand=${encodeURIComponent(name)}`),
    count: products.length,
    from: SHOW_PRICES && prices.length ? Math.min(...prices) : 0,
    ids: SHOW_PRICES ? variants.map((v) => v.id).join(' ') : undefined,
  };
}

const featured = shop.brandStrip
  .filter((b) => byBrand.has(b))
  .map((name) => {
    const f = BRAND_FONTS[name];
    const display = brandDisplay(name);
    const style = f
      ? `font-family:"om-${brandSlug(name)}",var(--font-display);--s:${f.size ?? 1}${f.tracking ? `;letter-spacing:${f.tracking}` : ''}`
      : undefined;
    return { ...quote(name), sym: symbol(name), display, style, custom: !!f };
  });
const others = [...byBrand.keys()]
  .filter((b) => !featured.some((x) => x.name === b))
  .map(quote)
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));

const faces = featured
  .filter((b) => b.custom)
  .map((b) => `@font-face{font-family:"om-${brandSlug(b.name)}";src:url("${asset(brandFontFile(b.name))}") format("woff2");font-display:swap}`)
  .join('');
const plural = (n) => `${n} ${n === 1 ? 'product' : 'products'}`;
// px per second: slow enough to read a name while it passes.
const SPEED = 42;
---

{
  featured.length > 0 && (
    <section class="border-y border-line bg-surface pt-6" aria-labelledby="brands-h">
      {faces && <style is:inline set:html={faces} />}
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-x-4 gap-y-1 px-4 pb-4">
        <h2 id="brands-h" class="flex items-center gap-2.5 text-xs font-black uppercase tracking-[0.2em] text-muted">
          <span class="live" aria-hidden="true" />
          Brands we stock
        </h2>
        <p class="font-mono text-[11px] uppercase tracking-wider text-muted">
          <span class="text-fg">{byBrand.size}</span> brands · <span class="text-fg">{catalog.products.length}</span> products
        </p>
      </div>

      <div class="tk tk-main" data-ticker data-speed={SPEED} data-pulse style={`--tk-dur:${featured.length * 6}s`}>
        <div class="tk-track">
          {[0, 1].map((copy) => (
            <ul class="tk-set" aria-hidden={copy ? 'true' : undefined}>
              {featured.map((b) => (
                <li class="tk-item">
                  <a class="tk-link" href={b.href} draggable="false" tabindex={copy ? '-1' : undefined} data-ids={b.ids} data-price={b.from || undefined}>
                    <span class="tk-sym" aria-hidden="true">{b.sym}</span>
                    <span class:list={['tk-name', !b.custom && 'tk-name-plain']} style={b.style} aria-hidden={b.display !== b.name ? 'true' : undefined}>
                      {b.display}
                    </span>
                    {b.display !== b.name && <span class="sr-only">{b.name}</span>}
                    <span class:list={['tk-q', b.from > 0 && 'tk-q-price']}>
                      <span class="tk-arrow" aria-hidden="true">▲</span>
                      {b.from > 0 && <span class="tk-price" data-from>{`from ${formatINR(b.from)}`}</span>}
                      <span class="tk-count">{plural(b.count)}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>

      {others.length > 0 && (
        <div class="tk tk-sub" data-ticker data-speed={Math.round(SPEED * 0.7)} data-dir="right" style={`--tk-dur:${others.length * 4}s`}>
          <div class="tk-track">
            {[0, 1].map((copy) => (
              <ul class="tk-set" aria-label={copy ? undefined : 'More brands'} aria-hidden={copy ? 'true' : undefined}>
                {others.map((b) => (
                  <li class="tk2-item">
                    <a class="tk2-link" href={b.href} draggable="false" tabindex={copy ? '-1' : undefined}>
                      {b.name}
                      <span class="tk2-n">
                        <span aria-hidden="true">{b.count}</span>
                        <span class="sr-only">{plural(b.count)}</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            ))}
          </div>
        </div>
      )}
    </section>
  )
}

<style>
  .live {
    position: relative;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--color-lime);
  }
  .live::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: inherit;
    animation: tk-ping 1.6s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  /* ---- the tapes ---- */
  .tk {
    position: relative;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 3rem, #000 calc(100% - 3rem), transparent);
    mask-image: linear-gradient(90deg, transparent, #000 3rem, #000 calc(100% - 3rem), transparent);
    touch-action: pan-y;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }
  .tk.is-drag {
    cursor: grabbing;
  }
  .tk-track {
    display: flex;
    width: max-content;
    /* No-JS fallback; the script takes over with a draggable Web Animation. */
    animation: tk-left var(--tk-dur, 60s) linear infinite;
  }
  .tk[data-dir='right'] .tk-track {
    animation-name: tk-right;
  }
  .tk:hover .tk-track,
  .tk:focus-within .tk-track {
    animation-play-state: paused;
  }
  .tk.is-js .tk-track {
    animation: none;
  }
  .tk-set {
    display: flex;
    flex-shrink: 0;
    align-items: stretch;
  }
  .tk a {
    -webkit-user-drag: none;
  }

  /* ---- featured brands ---- */
  .tk-main {
    --tk-size: 1.375rem;
    border-block: 1px solid var(--color-line);
    background: var(--color-ink);
  }
  @media (min-width: 640px) {
    .tk-main {
      --tk-size: 1.75rem;
    }
  }
  .tk-item {
    border-right: 1px solid var(--color-line);
  }
  .tk-link {
    display: flex;
    height: 4.25rem;
    align-items: center;
    gap: 0.75rem;
    padding: 0 1.5rem;
    color: color-mix(in srgb, var(--color-fg) 88%, transparent);
    transition: color 0.15s, background-color 0.15s;
  }
  @media (min-width: 640px) {
    .tk-link {
      height: 5rem;
      gap: 0.875rem;
      padding: 0 2rem;
    }
  }
  .tk-link:hover,
  .tk-link:focus-visible {
    color: var(--color-lime);
    background: color-mix(in srgb, var(--color-lime) 6%, transparent);
  }
  .tk-link:focus-visible {
    outline-offset: -2px;
  }
  .tk-sym {
    border: 1px solid var(--color-line);
    border-radius: 0.25rem;
    padding: 0.125rem 0.375rem;
    font: 700 0.625rem/1.2 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    transition: inherit;
  }
  .tk-link:hover .tk-sym,
  .tk-link:focus-visible .tk-sym {
    border-color: var(--color-lime);
    background: var(--color-lime);
    color: var(--color-ink);
  }
  .tk-name {
    font-size: calc(var(--tk-size) * var(--s, 1));
    font-weight: 400; /* each logo font file is already its own weight */
    font-style: normal;
    font-synthesis: none;
    line-height: 1;
    white-space: nowrap;
  }
  .tk-name-plain {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }
  .tk-q {
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
    font: 600 0.6875rem/1.15 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    white-space: nowrap;
    color: var(--color-muted);
  }
  .tk-arrow {
    display: inline-block;
    color: var(--color-lime);
    font-size: 0.625rem;
  }
  /* Checkout mode: price over product count, arrow beside the price. */
  .tk-q-price {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.125rem;
    padding-left: 0.875rem;
  }
  .tk-q-price .tk-arrow {
    position: absolute;
    margin: 0.0625rem 0 0 -0.875rem;
  }
  .tk-price {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-fg);
  }
  .tk-link.is-tick {
    animation: tk-flash 1.2s ease-out;
  }
  .tk-link.is-tick .tk-arrow {
    animation: tk-bump 0.7s ease-out;
  }

  /* ---- the rest of the brands ---- */
  .tk-sub {
    border-bottom: 1px solid var(--color-line);
  }
  .tk2-link {
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
    padding: 0.625rem 1rem;
    font: 600 0.6875rem/1 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    white-space: nowrap;
    color: var(--color-muted);
    transition: color 0.15s;
  }
  .tk2-link::before {
    content: '/';
    margin-right: 0.75rem;
    color: var(--color-line);
  }
  .tk2-link:hover,
  .tk2-link:focus-visible {
    color: var(--color-fg);
  }
  .tk2-n {
    color: var(--color-lime);
  }
  .tk2-link:focus-visible {
    outline-offset: -2px;
  }

  @keyframes tk-left {
    to {
      transform: translateX(-50%);
    }
  }
  @keyframes tk-right {
    from {
      transform: translateX(-50%);
    }
  }
  @keyframes tk-ping {
    75%,
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }
  @keyframes tk-flash {
    from {
      background: color-mix(in srgb, var(--color-lime) 22%, transparent);
    }
  }
  @keyframes tk-bump {
    35% {
      transform: translateY(-0.25rem) scale(1.3);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .live::after,
    .tk-link.is-tick,
    .tk-link.is-tick .tk-arrow {
      animation: none;
    }
    /* A plain swipeable row instead of a moving tape. */
    .tk {
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-mask-image: none;
      mask-image: none;
      cursor: auto;
    }
    .tk-track {
      animation: none;
    }
    .tk-set[aria-hidden='true'] {
      display: none;
    }
  }
</style>

<script>
  import { SHOW_PRICES } from '../lib/env.js';
  import { formatINR } from '../shared/order.js';

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  function initTape(el) {
    const track = el.querySelector('.tk-track');
    const speed = Number(el.dataset.speed) || 40;
    const right = el.dataset.dir === 'right';
    let W = 0; // width of one copy of the list = one loop
    let anim = null;
    let rate = 1; // eased playback rate: 1 = cruising, 0 = stopped
    let vel = 0; // fling speed after a drag, px/ms
    let hover = false;
    let focus = false;
    let drag = null;
    let holdUntil = 0;
    let visible = true;
    let raf = 0;
    let last = 0;
    let suppressClick = false;

    const duration = () => anim.effect.getComputedTiming().duration;

    function build() {
      const set = track.firstElementChild;
      const w = set.getBoundingClientRect().width;
      if (!w) return;
      // Progress through the loop, carried over from the CSS animation or the previous build.
      const old = anim || track.getAnimations?.()[0];
      const d0 = old?.effect?.getComputedTiming().duration;
      const progress = old && d0 ? (Number(old.currentTime) % d0) / d0 : 0;
      W = w;
      // Enough copies that the tape never runs out on a wide screen.
      while (track.children.length * W < el.clientWidth + W) {
        const copy = track.lastElementChild.cloneNode(true);
        copy.setAttribute('aria-hidden', 'true');
        copy.removeAttribute('aria-label');
        copy.querySelectorAll('a').forEach((a) => (a.tabIndex = -1));
        track.append(copy);
      }
      el.classList.add('is-js');
      anim?.cancel();
      const frames = [{ transform: 'translateX(0)' }, { transform: `translateX(${-W}px)` }];
      anim = track.animate(right ? frames.reverse() : frames, { duration: (W / speed) * 1000, iterations: Infinity });
      anim.currentTime = progress * duration();
      anim.playbackRate = rate;
      if (!visible) anim.pause();
    }

    // Move the tape by px (positive = to the right), wrapping around the loop.
    function shift(px) {
      const d = duration();
      const t = Number(anim.currentTime) + ((right ? px : -px) * d) / W;
      anim.currentTime = ((t % d) + d) % d;
    }

    function frame(now) {
      const dt = Math.min(now - last, 64);
      last = now;
      const target = hover || focus || drag || now < holdUntil ? 0 : 1;
      rate += (target - rate) * Math.min(1, dt / 220);
      if (Math.abs(target - rate) < 0.01) rate = target;
      anim.playbackRate = rate;
      if (!drag && Math.abs(vel) > 0.005) {
        shift(vel * dt);
        vel *= Math.pow(0.94, dt / 16);
      } else if (!drag) vel = 0;
      raf = rate !== target || vel || now < holdUntil ? requestAnimationFrame(frame) : 0;
    }
    function wake() {
      if (raf || !anim) return;
      last = performance.now();
      raf = requestAnimationFrame(frame);
    }

    el.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse') return;
      hover = true;
      wake();
    });
    el.addEventListener('pointerleave', (e) => {
      if (e.pointerType !== 'mouse') return;
      hover = false;
      wake();
    });

    el.addEventListener('pointerdown', (e) => {
      if (e.button !== 0 || !anim) return;
      drag = { id: e.pointerId, x0: e.clientX, x: e.clientX, t: e.timeStamp, v: 0, moved: false };
      vel = 0;
      wake();
    });
    el.addEventListener('pointermove', (e) => {
      if (!drag || e.pointerId !== drag.id) return;
      const dx = e.clientX - drag.x;
      if (!drag.moved && Math.abs(e.clientX - drag.x0) > 6) {
        drag.moved = true;
        el.setPointerCapture(e.pointerId);
        el.classList.add('is-drag');
      }
      if (drag.moved) {
        shift(dx);
        drag.v = 0.7 * (dx / Math.max(1, e.timeStamp - drag.t)) + 0.3 * drag.v;
      }
      drag.x = e.clientX;
      drag.t = e.timeStamp;
    });
    const endDrag = (e) => {
      if (!drag || e.pointerId !== drag.id) return;
      if (drag.moved) {
        vel = e.type === 'pointerup' ? Math.max(-3, Math.min(3, drag.v)) : 0;
        suppressClick = true;
        setTimeout(() => (suppressClick = false), 0);
      }
      // A finger lifted: hold still a moment so the name can be read or tapped.
      if (e.pointerType !== 'mouse') holdUntil = performance.now() + 1800;
      el.classList.remove('is-drag');
      drag = null;
      wake();
    };
    el.addEventListener('pointerup', endDrag);
    el.addEventListener('pointercancel', endDrag);
    // A drag is not a click on the brand under the pointer.
    el.addEventListener(
      'click',
      (e) => {
        if (!suppressClick) return;
        e.preventDefault();
        e.stopPropagation();
      },
      true,
    );
    el.addEventListener('dragstart', (e) => e.preventDefault());

    // Keyboard: stop, and bring the focused brand fully into view. (A mouse press also
    // focuses the link; that must not leave the tape stopped after the pointer has gone.)
    el.addEventListener('focusin', (e) => {
      let keyboard = true;
      try {
        keyboard = e.target.matches(':focus-visible');
      } catch {
        // older browsers: treat every focus as keyboard focus
      }
      if (!keyboard || !anim) return;
      focus = true;
      rate = 0;
      anim.playbackRate = 0;
      const box = el.getBoundingClientRect();
      const r = e.target.getBoundingClientRect();
      const pad = 48;
      if (r.left < box.left + pad) shift(box.left + pad - r.left);
      else if (r.right > box.right - pad) shift(box.right - pad - r.right);
      wake();
    });
    el.addEventListener('focusout', (e) => {
      if (el.contains(e.relatedTarget)) return;
      focus = false;
      wake();
    });

    // Off screen: stop the animation (saves battery on phones).
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (anim) visible ? anim.play() : anim.pause();
    }).observe(el);
    // Logo fonts arriving or a new screen width change the loop length.
    new ResizeObserver(build).observe(track.firstElementChild);

    return { el, isIdle: () => visible && !hover && !drag && !focus };
  }

  // Now and then a brand "ticks" like a price update.
  function pulse(tape) {
    const step = () => {
      if (tape.isIdle() && document.visibilityState === 'visible') {
        const box = tape.el.getBoundingClientRect();
        const inView = [...tape.el.querySelectorAll('.tk-link')].filter((a) => {
          const r = a.getBoundingClientRect();
          return r.left > box.left + 48 && r.right < box.right - 48;
        });
        const a = inView[Math.floor(Math.random() * inView.length)];
        if (a) {
          a.classList.remove('is-tick');
          void a.offsetWidth; // restart the animation
          a.classList.add('is-tick');
        }
      }
      setTimeout(step, 1400 + Math.random() * 1600);
    };
    setTimeout(step, 1200);
  }

  // Checkout mode: keep each brand's "from" price in step with the live stock feed.
  async function livePrices(root) {
    const { feed, loadFeed, liveVariant } = await import('../client/store.js');
    const update = (f) => {
      if (!f) return;
      root.querySelectorAll('.tk-link[data-ids]').forEach((a) => {
        const live = a.dataset.ids
          .split(' ')
          .map((id) => liveVariant({ id }, f))
          .filter((v) => v.buyable && v.stock > 0 && v.price > 0);
        const label = a.querySelector('[data-from]');
        if (!label) return;
        const price = live.length ? Math.min(...live.map((v) => v.price)) : 0;
        const old = Number(a.dataset.price) || 0;
        if (price === old) return;
        a.dataset.price = price ? String(price) : '';
        label.textContent = price ? `from ${formatINR(price)}` : 'out of stock';
        // Like a market tape: ▼ when the price fell since the page was built, else ▲.
        a.querySelector('.tk-arrow').textContent = price && old && price < old ? '▼' : '▲';
        a.classList.remove('is-tick');
        void a.offsetWidth;
        a.classList.add('is-tick');
      });
    };
    feed.sub(update);
    update(await loadFeed());
  }

  if (!reduce && 'animate' in Element.prototype) {
    document.querySelectorAll('[data-ticker]').forEach((el) => {
      const tape = initTape(el);
      if (el.hasAttribute('data-pulse')) pulse(tape);
    });
  }
  if (SHOW_PRICES) {
    const main = document.querySelector('.tk-main');
    if (main) livePrices(main);
  }
</script>
