---
import { SHOW_PRICES, asset, url } from '../lib/env.js';
import Layout from '../layouts/Layout.astro';
import BrandTicker from '../components/BrandTicker.astro';
import ProductGrid from '../components/ProductGrid.jsx';
import { absUrl, cardData, catalog, categoriesWithProducts, codOn, isPlaceholder, payWays, pickupOn, shop, telHref, waHref } from '../lib/site.js';
import { formatINR } from '../shared/order.js';

const s = catalog.settings;
const best = catalog.products.filter((p) => p.bestseller).slice(0, 8).map(cardData);

// Hero bento: the first four categories, each with pack photos (bestsellers first).
// The lead tile fans out three packs, the others show one.
const heroCats = categoriesWithProducts.slice(0, 4).map((c, i) => {
  const inCat = catalog.products.filter((p) => p.category === c.slug);
  const withPhoto = inCat.filter((p) => p.image);
  const packs = [...withPhoto.filter((p) => p.bestseller), ...withPhoto.filter((p) => !p.bestseller)].slice(0, i === 0 ? 3 : 1).map((p) => p.image);
  return { ...c, packs, brands: new Set(inCat.map((p) => p.brand)).size };
});

const trust = [
  { t: 'Genuine products', d: 'From authorised importers and brands. Invoice on request.' },
  { t: 'One-day home delivery', d: `All over ${shop.serviceArea}${SHOW_PRICES && s.FreeDeliveryAbove > 0 ? ` · free above ${formatINR(s.FreeDeliveryAbove)}` : ''}` },
  codOn
    ? { t: 'UPI or pay on delivery', d: pickupOn ? 'Or pick up from the shop and pay there.' : 'Cash or UPI at your door.' }
    : { t: 'Easy UPI payment', d: pickupOn ? 'GPay, PhonePe, Paytm or any UPI app – or pick up from the shop.' : 'GPay, PhonePe, Paytm or any UPI app.' },
  { t: 'Real people on WhatsApp', d: s.ReplyPromise },
];

const steps = SHOW_PRICES
  ? [
      { t: 'Add to cart', d: 'Pick your size and flavour. Stock is live from our shelf.' },
      { t: 'Place the order', d: `${pickupOn ? 'Delivery or pickup' : 'Home delivery'}. Pay by ${payWays}.` },
      { t: 'Send it on WhatsApp', d: 'One tap sends us your order. We confirm and pack it.' },
    ]
  : [
      { t: 'Add to cart', d: 'Pick your products, size and flavour.' },
      { t: 'Send it on WhatsApp', d: 'One tap opens WhatsApp with your list. Just press send.' },
      { t: 'We confirm', d: `We reply with today’s price and delivery. Pay by ${payWays}.` },
    ];

const store = {
  '@context': 'https://schema.org',
  '@type': 'Store',
  name: shop.name,
  url: absUrl('/'),
  telephone: shop.phoneDial,
  image: absUrl('/og.png'),
  address: {
    '@type': 'PostalAddress',
    streetAddress: isPlaceholder(shop.addressLines[0]) ? undefined : shop.addressLines[0],
    addressLocality: shop.addressLocality || undefined,
    addressRegion: shop.addressRegion,
    postalCode: shop.postalCode || undefined,
    addressCountry: 'IN',
  },
  areaServed: shop.serviceArea,
  ...(shop.mapsUrl ? { hasMap: shop.mapsUrl } : {}),
  ...(shop.instagram ? { sameAs: [shop.instagram] } : {}),
};
---

<Layout jsonLd={store}>
  <section class="relative overflow-hidden border-b border-line">
    <div class="pointer-events-none absolute -right-32 -top-32 size-[28rem] rounded-full bg-lime/10 blur-3xl" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-7xl gap-8 px-4 py-12 sm:py-16 lg:grid-cols-[1.2fr_1fr] lg:items-center lg:py-24">
      <div>
        <p class="mb-4 text-xs font-black uppercase tracking-[0.2em] text-lime">Supplements · One-day delivery across {shop.serviceArea}</p>
        <h1 class="display text-5xl sm:text-6xl lg:text-7xl">
          Fuel for<br /><span class="italic text-lime">one more</span><br />rep.
        </h1>
        <p class="mt-5 max-w-md text-lg text-muted">
          {`Whey, gainers, creatine and pre-workouts from the brands you trust. ${SHOW_PRICES ? `Order here, pay by ${codOn ? 'UPI or on delivery' : 'UPI'}, and get it at your door in one day, anywhere in ${shop.serviceArea}.` : `Add what you need, send the list to us on WhatsApp, and get it at your door in one day, anywhere in ${shop.serviceArea}.`}`}
        </p>
        <p lang="ta" class="ta mt-2">தமிழ்நாடு முழுவதும் ஒரே நாளில் வீட்டுக்கு டெலிவரி.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={url('/shop/whey-protein/')} class="btn btn-lime px-6 text-base">Shop whey protein</a>
          <a href={url('/shop/')} class="btn btn-ghost px-6 text-base">All products</a>
        </div>
      </div>
      <ul class="bento hidden lg:grid">
        {
          heroCats.map((c, i) => (
            <li class={`bento-${i}`}>
              <a href={url(`/shop/${c.slug}/`)} class:list={['tile group', i === 0 && 'tile-lead']}>
                <span class="tile-top">
                  <span class="tile-idx">{String(i + 1).padStart(2, '0')}</span>
                  <span class="tile-go" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <path d="M7 17 17 7M9 7h8v8" />
                    </svg>
                  </span>
                </span>
                {c.packs.length > 0 && (
                  <span class="tile-packs" aria-hidden="true">
                    {c.packs.map((src, k) => {
                      const off = k - (c.packs.length - 1) / 2;
                      return <img src={asset(src)} alt="" width="800" height="800" loading="lazy" decoding="async" class="pack" style={`--k:${off};z-index:${10 - Math.abs(off) * 2}`} />;
                    })}
                  </span>
                )}
                <span class="tile-text">
                  <span class="tile-count">
                    <span class="tile-num">{c.count}</span>
                    <span class="tile-unit">
                      products
                      <br />
                      {c.brands} {c.brands === 1 ? 'brand' : 'brands'}
                    </span>
                  </span>
                  <span class="display tile-name">{c.name}</span>
                  <span class="tile-blurb">{c.blurb}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-12" aria-labelledby="cat-h">
    <h2 id="cat-h" class="display mb-6 text-2xl sm:text-3xl">Shop by category</h2>
    <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
      {
        categoriesWithProducts.map((c) => (
          <li>
            <a href={url(`/shop/${c.slug}/`)} class="card group flex h-full flex-col justify-between gap-6 p-4 transition-colors hover:border-lime">
              <span class="text-xs font-bold text-muted">{c.count} {c.count === 1 ? 'product' : 'products'}</span>
              <span>
                <span class="block text-lg font-black leading-tight group-hover:text-lime">{c.name}</span>
                <span class="block text-xs text-muted">{c.blurb}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    best.length > 0 && (
      <section class="mx-auto max-w-7xl px-4 py-6" aria-labelledby="best-h">
        <div class="mb-6 flex items-end justify-between gap-4">
          <h2 id="best-h" class="display text-2xl sm:text-3xl">
            Best <span class="text-lime">sellers</span>
          </h2>
          <a href={url('/shop/')} class="text-sm font-bold text-lime hover:underline">See all →</a>
        </div>
        <ProductGrid client:visible products={best} settings={s} />
      </section>
    )
  }

  <section class="mx-auto max-w-7xl px-4 py-12" aria-label="Why shop with us">
    <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {
        trust.map((x) => (
          <li class="card flex gap-3 p-4">
            <svg class="mt-0.5 size-6 shrink-0 text-lime" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="m5 12 5 5 9-10" />
            </svg>
            <span>
              <span class="block font-black">{x.t}</span>
              <span class="block text-sm text-muted">{x.d}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <BrandTicker />

  <section class="mx-auto max-w-7xl px-4 py-12" aria-labelledby="how-h">
    <h2 id="how-h" class="display mb-6 text-2xl sm:text-3xl">How ordering works</h2>
    <ol class="grid gap-3 sm:grid-cols-3">
      {
        steps.map((x, i) => (
          <li class="card p-5">
            <span class="display text-4xl text-lime">{i + 1}</span>
            <span class="mt-2 block text-lg font-black">{x.t}</span>
            <span class="block text-sm text-muted">{x.d}</span>
          </li>
        ))
      }
    </ol>
    <p class="mt-6 text-sm text-muted">
      Questions first? <a class="font-bold text-lime underline" href={waHref()} target="_blank" rel="noopener">WhatsApp us</a> or <a class="font-bold text-lime underline" href={telHref}>call {shop.phoneDisplay}</a>.
    </p>
  </section>
</Layout>

<style>
  /* ---- Hero bento: tall lead tile, two beside it, one wide underneath ---- */
  .bento {
    grid-template-columns: 1.15fr 1fr;
    grid-template-rows: 12.5rem 12.5rem 9.5rem;
    gap: 0.75rem;
  }
  .bento-0 {
    grid-row: 1 / 3;
  }
  .bento-3 {
    grid-column: 1 / 3;
  }
  .tile {
    position: relative;
    isolation: isolate;
    display: flex;
    height: 100%;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 1.25rem;
    padding: 1.125rem 1.25rem;
    background:
      radial-gradient(120% 90% at 100% 100%, color-mix(in srgb, var(--color-lime) 9%, transparent), transparent 60%),
      repeating-linear-gradient(135deg, transparent 0 14px, rgb(255 255 255 / 0.018) 14px 15px),
      var(--color-surface);
    transition: border-color 0.2s, transform 0.2s;
  }
  .tile:hover,
  .tile:focus-visible {
    border-color: var(--color-lime);
    transform: translateY(-2px);
  }
  .tile-lead {
    border-color: var(--color-lime);
    background:
      radial-gradient(90% 60% at 50% 42%, rgb(255 255 255 / 0.35), transparent 70%),
      repeating-linear-gradient(135deg, transparent 0 14px, rgb(0 0 0 / 0.05) 14px 15px),
      var(--color-lime);
    color: var(--color-ink);
  }

  .tile-top {
    position: relative;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .tile-idx {
    font: 700 0.6875rem/1 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    letter-spacing: 0.12em;
    color: var(--color-muted);
  }
  .tile-lead .tile-idx {
    color: rgb(10 10 10 / 0.6);
  }
  .tile-go {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    color: var(--color-fg);
    transition: background-color 0.2s, color 0.2s, border-color 0.2s, transform 0.25s;
  }
  .tile-go svg {
    width: 1rem;
    height: 1rem;
  }
  .tile:hover .tile-go,
  .tile:focus-visible .tile-go {
    border-color: var(--color-lime);
    background: var(--color-lime);
    color: var(--color-ink);
    transform: rotate(45deg);
  }
  .tile-lead .tile-go {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: var(--color-lime);
  }
  .tile-lead:hover .tile-go,
  .tile-lead:focus-visible .tile-go {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: var(--color-lime);
  }

  /* Pack photos as tilted product cards. */
  .tile-packs {
    position: absolute;
    z-index: 0;
    right: -1rem;
    bottom: -1.25rem;
    width: 7rem;
    pointer-events: none;
  }
  .pack {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.875rem;
    box-shadow: 0 18px 36px -10px rgb(0 0 0 / 0.7);
    transform: rotate(12deg);
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .tile:hover .pack,
  .tile:focus-visible .pack {
    transform: rotate(4deg) translateY(-0.5rem) scale(1.04);
  }
  .bento-3 .tile-packs {
    right: 4.5rem;
    bottom: -2.5rem;
    width: 8.5rem;
  }
  .bento-3 .pack {
    transform: rotate(-7deg);
  }
  .bento-3 .tile:hover .pack,
  .bento-3 .tile:focus-visible .pack {
    transform: rotate(-2deg) translateY(-0.75rem) scale(1.04);
  }
  /* Lead tile: three packs fanned out, spreading on hover. */
  /* Sized against the tile's width so the outer packs never fall off the edge. */
  .tile-lead .tile-packs {
    inset: 4rem 0 auto;
    width: auto;
    height: 12rem;
  }
  .tile-lead .pack {
    position: absolute;
    top: 0;
    left: 50%;
    width: 36%;
    box-shadow: 0 20px 40px -12px rgb(0 0 0 / 0.55);
    transform: translateX(calc(-50% + var(--k) * 70%)) translateY(calc(var(--k) * var(--k) * 0.75rem)) rotate(calc(var(--k) * 10deg));
  }
  .tile-lead:hover .pack,
  .tile-lead:focus-visible .pack {
    transform: translateX(calc(-50% + var(--k) * 78%)) translateY(calc(var(--k) * var(--k) * 1rem - 0.5rem)) rotate(calc(var(--k) * 13deg));
  }

  .tile-text {
    position: relative;
    z-index: 20;
    display: flex;
    max-width: 64%;
    flex-direction: column;
  }
  .tile-lead .tile-text,
  .bento-3 .tile-text {
    max-width: none;
  }
  .tile-count {
    display: flex;
    align-items: flex-end;
    gap: 0.5rem;
    margin-bottom: 0.375rem;
  }
  .tile-num {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 2.75rem;
    line-height: 0.8;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--color-lime);
    transition: color 0.2s;
  }
  .tile:hover .tile-num,
  .tile:focus-visible .tile-num {
    color: var(--color-lime);
  }
  .tile-lead .tile-num,
  .tile-lead:hover .tile-num,
  .tile-lead:focus-visible .tile-num {
    font-size: 3.5rem;
    color: var(--color-ink);
    -webkit-text-stroke: 0;
  }
  .tile-unit {
    font: 600 0.625rem/1.25 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }
  .tile-lead .tile-unit {
    color: rgb(10 10 10 / 0.65);
  }
  .tile-name {
    font-size: 1.125rem;
  }
  .tile-lead .tile-name {
    font-size: 2rem;
  }
  .bento-3 .tile-name {
    font-size: 1.375rem;
  }
  .tile-blurb {
    margin-top: 0.25rem;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  .tile-lead .tile-blurb {
    color: rgb(10 10 10 / 0.7);
    font-weight: 600;
  }
  .tile-lead:focus-visible {
    outline-color: var(--color-fg);
  }

  @media (prefers-reduced-motion: reduce) {
    .tile,
    .pack,
    .tile-go {
      transition: none;
    }
  }
</style>
