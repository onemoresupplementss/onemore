---
import Layout from '../layouts/Layout.astro';
import OrderView from '../components/OrderView.jsx';
import { catalog, isPlaceholder, shop } from '../lib/site.js';

const s = catalog.settings;
const publicShop = {
  name: shop.name,
  whatsappNumber: shop.whatsappNumber,
  upiId: shop.upiId,
  upiPayeeName: shop.upiPayeeName,
  upiNameCustomersSee: isPlaceholder(shop.upiNameCustomersSee) ? '' : shop.upiNameCustomersSee,
  upiPayLinkTested: shop.upiPayLinkTested === true,
};
---

<Layout title="Your order" noindex>
  <div class="mx-auto max-w-6xl px-4 py-8">
    <OrderView client:only="preact" shop={publicShop} replyPromise={s.ReplyPromise} reviewLink={s.ReviewLink} callFirstAbove={s.CallFirstCODAbove} />
  </div>
</Layout>
