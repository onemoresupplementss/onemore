---
import { asset, SHOW_PRICES, url } from '../../lib/env.js';
import Layout from '../../layouts/Layout.astro';
import ProductBuy from '../../components/ProductBuy.jsx';
import ProductGrid from '../../components/ProductGrid.jsx';
import ProductPhoto from '../../components/ProductPhoto.jsx';
import { absUrl, cardData, catalog, filled, pickupOn, shop, waHref } from '../../lib/site.js';
import { formatNetQty, lineLabel } from '../../shared/order.js';
import { parseDescription } from '../../lib/describe.js';
import { flavourSlug } from '../../shared/catalog.js';
import { existsSync } from 'node:fs';

export function getStaticPaths() {
  return catalog.products.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props;
const info = p.info || {};
const v0 = p.variants[0];
const related = catalog.products.filter((x) => x.category === p.category && x.slug !== p.slug).slice(0, 4).map(cardData);
const images = [...new Set([p.image, ...p.variants.map((v) => v.image)].filter(Boolean))];

const veg = /non/i.test(info.vegNonVeg || '') ? 'non-veg' : /veg/i.test(info.vegNonVeg || '') ? 'veg' : '';
const labelRows = [
  ['Product type', info.genericName],
  ['Ingredients', info.ingredients],
  ['Nutrition facts', info.nutrition],
  ['Warnings', info.warnings],
  ['Manufactured by', info.manufacturer],
  ['Imported by', info.importer],
  ['Country of origin', info.countryOfOrigin],
  ['Consumer care', info.consumerCare],
].filter(([, val]) => val);
const desc = parseDescription(p.description);
// Flavour pictures for the "Choose your flavour" tiles: public/products/<group>-flavour-<flavour>.webp
const swatches = Object.fromEntries(
  p.flavours
    .map((fl) => [fl, `products/${p.slug}-flavour-${flavourSlug(fl)}.webp`])
    .filter(([, file]) => existsSync(`public/${file}`))
    .map(([fl, file]) => [fl, asset(file)]),
);
const packSizes = p.variants.map((v) => (v.netQty ? formatNetQty(v.netQty, v.unit) : v.size)).filter((x, i, a) => x && a.indexOf(x) === i);
const missingLabel = !info.ingredients || !info.nutrition || !info.countryOfOrigin || (/yes/i.test(info.imported || '') && !info.importer);

const description =
  p.description ||
  `${p.brand} ${p.name} (${p.sizes.join(', ')}) at ${shop.name}. Genuine stock, ${SHOW_PRICES ? 'live availability' : 'order on WhatsApp'}, one-day home delivery across ${shop.serviceArea}${pickupOn ? ' or store pickup' : ''}.`;
const ask = `Hi ${shop.name}, can you send the label photo of ${p.brand} ${p.name}?`;

// Search-engine product data needs a price, so it is only added in checkout mode
// and never for options without a price yet ("Ask").
const priced = p.variants.filter((v) => !v.ask);
const offers = priced.map((v) => ({
  '@type': 'Offer',
  sku: v.id,
  name: lineLabel({ brand: p.brand, name: p.name, size: v.size, flavour: v.flavour }),
  price: v.price,
  priceCurrency: 'INR',
  availability: !v.soldOut ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
  url: absUrl(`/p/${p.slug}/?v=${encodeURIComponent(v.id)}`),
  seller: { '@type': 'Organization', name: shop.name },
}));
const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${p.brand} ${p.name}`,
  brand: { '@type': 'Brand', name: p.brand },
  category: p.categoryName,
  description,
  sku: v0.id,
  ...(images.length ? { image: images.map((i) => absUrl(i)) } : {}),
  offers: offers.length === 1 ? offers[0] : { '@type': 'AggregateOffer', priceCurrency: 'INR', lowPrice: Math.min(...priced.map((v) => v.price)), highPrice: Math.max(...priced.map((v) => v.price)), offerCount: offers.length, offers },
};
const crumbsLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Shop', item: absUrl('/shop/') },
    { '@type': 'ListItem', position: 2, name: p.categoryName, item: absUrl(`/shop/${p.category}/`) },
    { '@type': 'ListItem', position: 3, name: `${p.brand} ${p.name}` },
  ],
};
---

<Layout title={`${p.brand} ${p.name}`} description={description} image={images[0] || '/og.png'} jsonLd={SHOW_PRICES && priced.length ? [productLd, crumbsLd] : [crumbsLd]} waText={`Hi ${shop.name}, I have a question about ${p.brand} ${p.name}.`} waRaised>
  <div class="mx-auto max-w-7xl px-4 py-6 pb-28 lg:pb-6">
    <nav aria-label="Breadcrumb" class="mb-4 text-xs text-muted">
      <a href={url('/shop/')} class="hover:text-lime">Shop</a> / <a href={url(`/shop/${p.category}/`)} class="hover:text-lime">{p.categoryName}</a>
    </nav>
    <div class="grid gap-8 lg:grid-cols-2 lg:gap-12">
      <div class="space-y-3">
        <ProductPhoto
          client:idle
          variants={p.variants.map((v) => ({ id: v.id, image: v.image, size: v.size }))}
          image={p.image}
          brand={p.brand}
          name={p.name}
          labels={info.labelImages || []}
          facts={desc.stats || info.ingredients ? { title: desc.stats?.title, tiles: (desc.stats?.tiles || []).slice(0, 4), ingredients: info.ingredients } : null}
        />
      </div>
      <div>
        <p class="text-sm font-bold uppercase tracking-wider text-lime">{p.brand}</p>
        <h1 class="mt-1 text-3xl font-black leading-tight sm:text-4xl">{p.name}</h1>
        <p class="mt-2 flex items-center gap-2 text-sm text-muted">
          {
            veg && (
              <span
                class:list={['inline-flex size-4 items-center justify-center border-2', veg === 'veg' ? 'border-[#1a9e3f]' : 'border-[#8b4513]']}
                role="img"
                aria-label={veg === 'veg' ? 'Vegetarian' : 'Non-vegetarian'}
              >
                <span class:list={['size-2 rounded-full', veg === 'veg' ? 'bg-[#1a9e3f]' : 'bg-[#8b4513]']} />
              </span>
            )
          }
          {p.categoryName}{p.badge && <> · <span class="text-lime">{p.badge}</span></>}
        </p>
        <div class="mt-6">
          <ProductBuy client:load product={{ slug: p.slug, brand: p.brand, name: p.name, image: p.image, variants: p.variants }} settings={catalog.settings} shop={{ name: shop.name, whatsappNumber: shop.whatsappNumber }} swatches={swatches} />
        </div>
      </div>
    </div>

    <div class="mt-10 grid gap-6 lg:mt-12 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] lg:gap-10">
      <section aria-labelledby="about-h" class="min-w-0">
        <h2 id="about-h" class="display mb-4 text-xl sm:text-2xl">About this product</h2>
        {
          (desc.stats || packSizes.length > 0) && (
            <div class="mb-5">
              {desc.stats && <p class="mb-2 text-xs font-bold uppercase tracking-wider text-muted">{desc.stats.title}</p>}
              <ul class="grid grid-cols-2 gap-2 sm:grid-cols-3 xl:grid-cols-4">
                {desc.stats?.tiles.map((t) => (
                  <li class="rounded-xl border border-line bg-surface p-3">
                    <span class="block text-xl font-black leading-tight text-lime sm:text-2xl">{t.value}</span>
                    <span class="mt-0.5 block text-sm leading-snug text-[#d4d4cf]">{t.label}</span>
                  </li>
                ))}
                {packSizes.length > 0 && (
                  <li class="rounded-xl border border-line bg-surface p-3">
                    <span class="block text-xl font-black leading-tight text-fg sm:text-2xl">{packSizes.join(' / ')}</span>
                    <span class="mt-0.5 block text-sm leading-snug text-[#d4d4cf]">pack size</span>
                  </li>
                )}
              </ul>
              {desc.stats?.extras.length > 0 && (
                <ul class="mt-2 flex flex-wrap gap-2">
                  {desc.stats.extras.map((x) => (
                    <li class="rounded-full border border-line px-3 py-1 text-xs text-[#d4d4cf]">{x}</li>
                  ))}
                </ul>
              )}
            </div>
          )
        }
        <div id="desc-body" class="desc-body relative">
          <div class="prose-shop">
            {p.description ? desc.intro.map((t) => <p class="whitespace-pre-line">{t}</p>) : <p>Full description coming soon. Ask us on WhatsApp for details, serving size or a label photo.</p>}
            {desc.sections.map((sec) => (
              <>
                <h3>{sec.title}</h3>
                <ul class="!list-none !pl-0">
                  {sec.items.map((it) => (
                    <li class="relative pl-6">
                      <span aria-hidden="true" class="absolute left-0 top-[0.55em] inline-block size-2.5 rounded-full bg-lime" />
                      {it}
                    </li>
                  ))}
                </ul>
              </>
            ))}
            {desc.howTo && (
              <div class="mt-5 rounded-xl border border-lime/40 bg-lime/5 p-4">
                <p class="!mt-0 text-xs font-bold uppercase tracking-wider text-lime">{desc.howTo.title}</p>
                <p class="!mt-1">{desc.howTo.text}</p>
              </div>
            )}
            <h3>Good to know</h3>
            <ul>
              <li>Every tub is sealed. Imported products carry the Indian importer’s sticker.</li>
              <li>Supplements are not a substitute for a varied diet. Do not exceed the serving size on the label.</li>
            </ul>
          </div>
          <div class="desc-fade pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-ink to-transparent lg:hidden" aria-hidden="true" />
        </div>
        <button type="button" id="desc-toggle" class="btn btn-ghost mt-3 w-full lg:hidden" aria-controls="desc-body" aria-expanded="false" hidden>
          Read full description
        </button>
      </section>
      <section aria-labelledby="label-h" class="min-w-0">
        <details id="label-box" class="card group" open>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-3 p-4 [&::-webkit-details-marker]:hidden">
            <h2 id="label-h" class="display text-lg sm:text-xl">Label details</h2>
            <span aria-hidden="true" class="text-2xl leading-none text-lime transition-transform group-open:rotate-45">+</span>
          </summary>
          <dl class="divide-y divide-line border-t border-line text-sm">
            {
              labelRows.map(([k, val]) => (
                <div class="grid gap-1 p-3 sm:grid-cols-[150px_1fr]">
                  <dt class="font-bold text-muted">{k}</dt>
                  <dd class="whitespace-pre-line break-words">{val}</dd>
                </div>
              ))
            }
            <div class="grid gap-1 p-3 sm:grid-cols-[150px_1fr]">
              <dt class="font-bold text-muted">Net quantity</dt>
              <dd>{packSizes.join(' / ')}</dd>
            </div>
            <div class="grid gap-1 p-3 sm:grid-cols-[150px_1fr]">
              <dt class="font-bold text-muted">Seller</dt>
              <dd>{filled(shop.legalName) || shop.name}, {shop.addressRegion}</dd>
            </div>
          </dl>
        </details>
        {
          missingLabel && (
            <p class="mt-3 text-sm text-muted">
              Some label details are still being added.{' '}
              <a class="font-bold text-lime underline" href={waHref(ask)} target="_blank" rel="noopener">
                Ask us for a label photo
              </a>{' '}
              before you buy.
            </p>
          )
        }
      </section>
    </div>
    <script is:inline>
      (function () {
        var small = window.matchMedia('(max-width: 1023px)');
        var body = document.getElementById('desc-body');
        var btn = document.getElementById('desc-toggle');
        var box = document.getElementById('label-box');
        if (small.matches && box) box.removeAttribute('open');
        if (!body || !btn) return;
        if (small.matches && body.scrollHeight > 420) {
          body.classList.add('is-collapsed');
          btn.hidden = false;
          btn.addEventListener('click', function () {
            var open = body.classList.toggle('is-collapsed') === false;
            btn.setAttribute('aria-expanded', String(open));
            btn.textContent = open ? 'Show less' : 'Read full description';
            if (!open) body.scrollIntoView({ block: 'start', behavior: 'smooth' });
          });
        }
      })();
    </script>

    {
      related.length > 0 && (
        <section class="mt-14" aria-labelledby="rel-h">
          <h2 id="rel-h" class="display mb-5 text-2xl">More {p.categoryName.toLowerCase()}</h2>
          <ProductGrid client:visible products={related} settings={catalog.settings} />
        </section>
      )
    }
  </div>
</Layout>
