---
import { asset, SHOW_PRICES, url } from '../../lib/env.js';
import Layout from '../../layouts/Layout.astro';
import ProductBuy from '../../components/ProductBuy.jsx';
import ProductGrid from '../../components/ProductGrid.jsx';
import ProductPhoto from '../../components/ProductPhoto.jsx';
import { absUrl, cardData, catalog, filled, pickupOn, shop, waHref } from '../../lib/site.js';
import { formatNetQty, lineLabel } from '../../shared/order.js';

export function getStaticPaths() {
  return catalog.products.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props;
const info = p.info || {};
const v0 = p.variants[0];
const related = catalog.products.filter((x) => x.category === p.category && x.slug !== p.slug).slice(0, 4).map(cardData);
const images = [...new Set([p.image, ...p.variants.map((v) => v.image)].filter(Boolean))];

const veg = /non/i.test(info.vegNonVeg || '') ? 'non-veg' : /veg/i.test(info.vegNonVeg || '') ? 'veg' : '';
const labelRows = [
  ['Product type', info.genericName],
  ['Ingredients', info.ingredients],
  ['Nutrition facts', info.nutrition],
  ['Warnings', info.warnings],
  ['Manufactured by', info.manufacturer],
  ['Imported by', info.importer],
  ['Country of origin', info.countryOfOrigin],
  ['Consumer care', info.consumerCare],
].filter(([, val]) => val);
const missingLabel = !info.ingredients || !info.nutrition || !info.countryOfOrigin || (/yes/i.test(info.imported || '') && !info.importer);

const description =
  p.description ||
  `${p.brand} ${p.name} (${p.sizes.join(', ')}) at ${shop.name}. Genuine stock, ${SHOW_PRICES ? 'live availability' : 'order on WhatsApp'}, one-day home delivery across ${shop.serviceArea}${pickupOn ? ' or store pickup' : ''}.`;
const ask = `Hi ${shop.name}, can you send the label photo of ${p.brand} ${p.name}?`;

// Search-engine product data needs a price, so it is only added in checkout mode.
const offers = p.variants.map((v) => ({
  '@type': 'Offer',
  sku: v.id,
  name: lineLabel({ brand: p.brand, name: p.name, size: v.size, flavour: v.flavour }),
  price: v.price,
  priceCurrency: 'INR',
  availability: v.stock > 0 ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
  url: absUrl(`/p/${p.slug}/?v=${encodeURIComponent(v.id)}`),
  seller: { '@type': 'Organization', name: shop.name },
}));
const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${p.brand} ${p.name}`,
  brand: { '@type': 'Brand', name: p.brand },
  category: p.categoryName,
  description,
  sku: v0.id,
  ...(images.length ? { image: images.map((i) => absUrl(i)) } : {}),
  offers: offers.length === 1 ? offers[0] : { '@type': 'AggregateOffer', priceCurrency: 'INR', lowPrice: Math.min(...p.variants.map((v) => v.price)), highPrice: Math.max(...p.variants.map((v) => v.price)), offerCount: offers.length, offers },
};
const crumbsLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Shop', item: absUrl('/shop/') },
    { '@type': 'ListItem', position: 2, name: p.categoryName, item: absUrl(`/shop/${p.category}/`) },
    { '@type': 'ListItem', position: 3, name: `${p.brand} ${p.name}` },
  ],
};
---

<Layout title={`${p.brand} ${p.name}`} description={description} image={images[0] || '/og.png'} jsonLd={SHOW_PRICES ? [productLd, crumbsLd] : [crumbsLd]} waText={`Hi ${shop.name}, I have a question about ${p.brand} ${p.name}.`} waRaised>
  <div class="mx-auto max-w-7xl px-4 py-6 pb-28 lg:pb-6">
    <nav aria-label="Breadcrumb" class="mb-4 text-xs text-muted">
      <a href={url('/shop/')} class="hover:text-lime">Shop</a> / <a href={url(`/shop/${p.category}/`)} class="hover:text-lime">{p.categoryName}</a>
    </nav>
    <div class="grid gap-8 lg:grid-cols-2 lg:gap-12">
      <div class="space-y-3">
        <div class="card overflow-hidden">
          <ProductPhoto client:idle variants={p.variants.map((v) => ({ id: v.id, image: v.image, size: v.size }))} image={p.image} brand={p.brand} name={p.name} />
        </div>
        {
          info.labelImages?.length > 0 && (
            <ul class="grid grid-cols-4 gap-2">
              {info.labelImages.map((src, i) => (
                <li>
                  <a href={asset(src)} target="_blank" rel="noopener" class="card block overflow-hidden" aria-label={`Open label photo ${i + 1}`}>
                    <img src={asset(src)} alt="" loading="lazy" width="150" height="150" class="aspect-square w-full object-cover" />
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
      <div>
        <p class="text-sm font-bold uppercase tracking-wider text-lime">{p.brand}</p>
        <h1 class="mt-1 text-3xl font-black leading-tight sm:text-4xl">{p.name}</h1>
        <p class="mt-2 flex items-center gap-2 text-sm text-muted">
          {
            veg && (
              <span
                class:list={['inline-flex size-4 items-center justify-center border-2', veg === 'veg' ? 'border-[#1a9e3f]' : 'border-[#8b4513]']}
                role="img"
                aria-label={veg === 'veg' ? 'Vegetarian' : 'Non-vegetarian'}
              >
                <span class:list={['size-2 rounded-full', veg === 'veg' ? 'bg-[#1a9e3f]' : 'bg-[#8b4513]']} />
              </span>
            )
          }
          {p.categoryName}{p.badge && <> · <span class="text-lime">{p.badge}</span></>}
        </p>
        <div class="mt-6">
          <ProductBuy client:load product={{ slug: p.slug, brand: p.brand, name: p.name, image: p.image, variants: p.variants }} settings={catalog.settings} shop={{ name: shop.name, whatsappNumber: shop.whatsappNumber }} />
        </div>
      </div>
    </div>

    <div class="mt-12 grid gap-8 lg:grid-cols-2">
      <section class="prose-shop">
        <h2>About this product</h2>
        {p.description ? <p class="whitespace-pre-line">{p.description}</p> : <p>Full description coming soon. Ask us on WhatsApp for details, serving size or a label photo.</p>}
        <h3>Good to know</h3>
        <ul>
          <li>Every tub is sealed. Imported products carry the Indian importer’s sticker.</li>
          <li>We ship only stock with at least {catalog.settings.MinDaysLeft ?? 45} days before its best-before date.</li>
          <li>Supplements are not a substitute for a varied diet. Do not exceed the serving size on the label.</li>
        </ul>
      </section>
      <section aria-labelledby="label-h">
        <h2 id="label-h" class="display mb-3 text-xl">Label details</h2>
        <dl class="card divide-y divide-line text-sm">
          {
            labelRows.map(([k, val]) => (
              <div class="grid gap-1 p-3 sm:grid-cols-[160px_1fr]">
                <dt class="font-bold text-muted">{k}</dt>
                <dd class="whitespace-pre-line">{val}</dd>
              </div>
            ))
          }
          <div class="grid gap-1 p-3 sm:grid-cols-[160px_1fr]">
            <dt class="font-bold text-muted">Net quantity</dt>
            <dd>{p.variants.map((v) => (v.netQty ? formatNetQty(v.netQty, v.unit) : v.size)).filter((x, i, a) => a.indexOf(x) === i).join(' / ')}</dd>
          </div>
          <div class="grid gap-1 p-3 sm:grid-cols-[160px_1fr]">
            <dt class="font-bold text-muted">Seller</dt>
            <dd>{filled(shop.legalName) || shop.name}, {shop.addressRegion}</dd>
          </div>
        </dl>
        {
          missingLabel && (
            <p class="mt-3 text-sm text-muted">
              Some label details are still being added.{' '}
              <a class="font-bold text-lime underline" href={waHref(ask)} target="_blank" rel="noopener">
                Ask us for a label photo
              </a>{' '}
              before you buy.
            </p>
          )
        }
      </section>
    </div>

    {
      related.length > 0 && (
        <section class="mt-14" aria-labelledby="rel-h">
          <h2 id="rel-h" class="display mb-5 text-2xl">More {p.categoryName.toLowerCase()}</h2>
          <ProductGrid client:visible products={related} settings={catalog.settings} />
        </section>
      )
    }
  </div>
</Layout>
