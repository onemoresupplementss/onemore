---
import Layout from '../layouts/Layout.astro';
import SellerDetails from '../components/SellerDetails.astro';
import { catalog, filled, shop, telHref, waHref } from '../lib/site.js';

// The map needs a real street address or a Google Maps link; until then it is left out.
const street = shop.addressLines.map(filled).filter(Boolean);
const hasMap = Boolean(shop.mapsUrl || filled(shop.addressLines[0]));
const query = encodeURIComponent([shop.name, ...street].join(' '));
const mapsLink = shop.mapsUrl || `https://www.google.com/maps/search/?api=1&query=${query}`;
const embed = `https://www.google.com/maps?q=${query}&output=embed`;
---

<Layout title="Contact & shop location" description={`Call or WhatsApp ${shop.name}. One-day home delivery all over ${shop.serviceArea}. Shop hours and address.`}>
  <div class="mx-auto max-w-5xl px-4 py-10">
    <h1 class="display text-3xl sm:text-4xl">Contact us</h1>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      <div class="space-y-4">
        <a href={waHref()} target="_blank" rel="noopener" class="card flex items-center gap-4 p-4 hover:border-lime">
          <span class="flex size-12 items-center justify-center rounded-full bg-[#25d366] text-white" aria-hidden="true">
            <svg class="size-6" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Z"></path></svg>
          </span>
          <span><span class="block font-black">WhatsApp</span><span class="text-sm text-muted">{shop.phoneDisplay} · fastest reply</span></span>
        </a>
        <a href={telHref} class="card flex items-center gap-4 p-4 hover:border-lime">
          <span class="flex size-12 items-center justify-center rounded-full bg-lime text-ink" aria-hidden="true">
            <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"></path></svg>
          </span>
          <span><span class="block font-black">Call</span><span class="text-sm text-muted">{shop.phoneDisplay}</span></span>
        </a>
        <div class="card p-4">
          <h2 class="font-black">Shop hours</h2>
          <p class="text-muted">{catalog.settings.ShopHours || filled(shop.hoursText)}</p>
          <h2 class="mt-4 font-black">Address</h2>
          <address class="not-italic text-muted">
            {street.map((l) => <>{l}<br /></>)}
          </address>
          {hasMap && <a href={mapsLink} target="_blank" rel="noopener" class="btn btn-ghost mt-4 w-full">Open in Google Maps</a>}
        </div>
        {filled(shop.email) && <p class="text-sm text-muted">Email: <a class="text-lime underline" href={`mailto:${shop.email}`}>{shop.email}</a></p>}
      </div>
      <div class="space-y-6">
        {hasMap && (
        <div class="card relative aspect-[4/3] overflow-hidden" id="map">
          {
            shop.mapImage ? (
              <img src={shop.mapImage} alt={`Map showing ${shop.name}`} class="size-full object-cover" loading="lazy" />
            ) : (
              <div class="flex size-full flex-col items-center justify-center gap-2 bg-surface-2 p-6 text-center">
                <svg class="size-10 text-lime" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12Z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>
                <p class="font-bold">{street[0]}</p>
              </div>
            )
          }
          <button type="button" data-embed={embed} class="btn btn-lime absolute bottom-3 left-1/2 -translate-x-1/2">Show map</button>
        </div>
        )}
        <div class="card p-4"><SellerDetails /></div>
      </div>
    </div>
  </div>
  <script>
    // Loads Google Maps only when asked, so the page stays fast.
    document.querySelector<HTMLButtonElement>('[data-embed]')?.addEventListener('click', (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      const frame = document.createElement('iframe');
      frame.src = btn.dataset.embed!;
      frame.title = 'Map to the shop';
      frame.loading = 'lazy';
      frame.referrerPolicy = 'no-referrer-when-downgrade';
      frame.className = 'absolute inset-0 size-full border-0';
      btn.parentElement!.appendChild(frame);
      btn.remove();
    });
  </script>
</Layout>
