---
import Page from '../layouts/Page.astro';
import { shop, waHref } from '../lib/site.js';

const founders = [
  { name: 'Fayz', role: 'Founder', initial: 'F' },
  { name: 'Safi', role: 'Co-founder', initial: 'S' },
];
---

<Page title="About us" description={`${shop.name} – genuine gym supplements and honest advice from Thiruthuraipoondi, delivered across ${shop.serviceArea}.`}>
  <p class="!text-lg !leading-relaxed !text-fg">
    Every rep is a promise you keep to yourself. <b class="text-lime">oneMore</b> is here for that one more rep.
  </p>

  <h2>Why we started</h2>
  <p>
    More people in Thiruthuraipoondi and Tiruvarur are training than ever – but genuine supplements and honest advice were hard to find.
    Fake tubs online, guesswork from videos, and myths like "protein is steroids". So we built a shop from our own town, for our own people.
  </p>

  <h2>What we believe</h2>
  <ul>
    <li><b>Food, sleep and training first.</b> Supplements only fill the gaps.</li>
    <li><b>Protein is food.</b> Whey comes from milk – nothing to fear.</li>
    <li><b>Genuine only.</b> Authorised importers and distributors, invoice on request.</li>
    <li><b>Honest prices.</b> Same as our counter, taxes included.</li>
  </ul>

  <h2>The team</h2>
  <ul class="not-prose !my-4 grid !list-none grid-cols-2 gap-3 !pl-0">
    {
      founders.map((f) => (
        <li class="flex items-center gap-3 rounded-xl border border-line bg-surface p-3 sm:p-4">
          <span class="display flex size-12 shrink-0 items-center justify-center rounded-full bg-lime text-xl text-ink" aria-hidden="true">{f.initial}</span>
          <div>
            <p class="!m-0 text-lg font-black !text-fg">{f.name}</p>
            <p class="!m-0 whitespace-nowrap text-xs font-bold uppercase tracking-wider !text-lime">{f.role}</p>
          </div>
        </li>
      ))
    }
  </ul>

  <p>
    One-day delivery across {shop.serviceArea}. Questions? <a href={waHref()} target="_blank" rel="noopener">Ask us on WhatsApp</a> – we are with you, one more rep at a time.
  </p>
</Page>
