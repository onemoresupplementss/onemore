---
// Simple text page (about, FAQ, policies).
import Layout from './Layout.astro';

interface Props {
  title: string;
  description?: string;
  updated?: string;
  jsonLd?: object | object[];
}
const { title, description, updated, jsonLd } = Astro.props;
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <article class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="display text-3xl sm:text-4xl">{title}</h1>
    {updated && <p class="mt-2 text-xs text-muted">Last updated {updated}</p>}
    <div class="prose-shop mt-6">
      <slot />
    </div>
  </article>
</Layout>
