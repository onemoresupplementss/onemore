/**
 * oneMore - Google Apps Script backend for the website.
 * =====================================================
 * This script lives inside the "oneMore Orders – private" spreadsheet (Extensions → Apps Script).
 * The full rules are in docs/api-contract.md in the website project.
 *
 * FILES
 *   Code.gs      web app (doPost/doGet): catalog, createOrder, attachUtr, notify + sheet helpers
 *   Rules.gs     shop rules copied from the website (visibility, settings, phone/pincode checks)
 *   Feed.gs      live feed push to the website, Products-file edit trigger, Check column,
 *                price log, website rebuild (deploy hook)
 *   Orders.gs    Orders-sheet edit trigger, Payment tab (UPI ID) alerts, stale-order reminder
 *   Setup.gs     one-time setup, keys, self-test, the "oneMore" menu
 *   Supplier.gs  ticked orders -> "oneMore – Supplier orders" (delivery details only, no payment)
 *   SeedData.gs  starter catalogue (generated by the website project - do not edit)
 *
 * FUNCTIONS THE OWNER RUNS (pick one in the editor's function list and press Run)
 *   setupAll            does everything below in one go (safe to run again any time)
 *   setupKeys           makes API_KEY and REFRESH_KEY (copy them into Cloudflare)
 *   setupProductsFile   makes/repairs the "oneMore Products" spreadsheet
 *   setupOrdersFile     makes/repairs the Orders tab, report tabs and timers
 *   selfTest            checks everything and lists problems in the log
 *   Menu "oneMore" in the Orders spreadsheet: push prices to website now, check products, rebuild website,
 *   self-test, set website address.
 *
 * SCRIPT PROPERTIES (Project Settings ⚙ → Script Properties)
 *   API_KEY            secret the website sends with every call (Cloudflare: APPS_SCRIPT_KEY)
 *   REFRESH_KEY        secret sent to <SITE_URL>/api/refresh (Cloudflare: REFRESH_KEY)
 *   SITE_URL           e.g. https://onemore.example.in (no slash at the end)
 *   PRODUCTS_SHEET_ID  ID of the "oneMore Products" spreadsheet (setupProductsFile fills it)
 *   DEPLOY_HOOK_URL    Cloudflare Pages deploy hook (for "Rebuild website now" and the daily rebuild)
 *   ORDER_SEQ          last order number used (1000 → first order is ORD-1001)
 *   LAST_FEED_HASH     version of the last feed the website accepted
 *   Also used internally: ORDERS_SHEET_ID, FEED_PUSH_SCHEDULED_AT, STATUS_*, PRICE_CACHE_*.
 *
 * TRIGGERS (made by the setup functions)
 *   onOrdersEdit        when the Orders sheet is edited (Status/Payment → Updated; Send to supplier / Status →
 *                       supplier sheet; Payment tab (UPI ID) changed → email to the owner)
 *   onProductsEdit      when the Products file is edited (push to website ~30 s later; Publish now)
 *   runScheduledFeedPush  one-off, ~30 s after a Products edit (removes itself)
 *   timerTick           every 5 minutes: Check column + push the feed if anything changed
 *   staleOrderReminder  every 30 minutes: email about unpaid New orders older than 2 hours
 *   dailyRebuild        every day around 5 am: rebuild the website (new products, photos)
 */

const TZ = 'Asia/Kolkata';
const ORDERS_TAB = 'Orders';

// Orders columns: field name used in this script -> header text in the sheet (contract order).
const ORDER_FIELDS = [
  ['orderId', 'Order ID'],
  ['created', 'Created'],
  ['status', 'Status'],
  ['payment', 'Payment'],
  ['method', 'Method'],
  ['total', 'Total'],
  ['name', 'Name'],
  ['phone', 'Phone'],
  ['fulfilment', 'Fulfilment'],
  ['area', 'Area'],
  ['pincode', 'Pincode'],
  ['address', 'Address'],
  ['landmark', 'Landmark'],
  ['items', 'Items'],
  ['subtotal', 'Subtotal'],
  ['deliveryFee', 'Delivery fee'],
  ['notes', 'Notes'],
  ['utr', 'UTR'],
  ['utrFlag', 'UTR flag'],
  ['source', 'Source'],
  ['updated', 'Updated'],
  ['itemsJson', 'ItemsJSON'],
  ['idemKey', 'IdemKey'],
];
const ORDER_HEADERS = ORDER_FIELDS.map((f) => f[1]);
// Columns that always hold text (never numbers, dates or formulas).
const ORDER_TEXT_FIELDS = ['orderId', 'status', 'payment', 'method', 'name', 'phone', 'fulfilment', 'area', 'pincode',
  'address', 'landmark', 'items', 'notes', 'utr', 'utrFlag', 'source', 'itemsJson', 'idemKey'];

const STATUSES = ['New', 'Packed', 'Ready for pickup', 'Delivered', 'Cancelled'];
const PAYMENTS = ['Pending', 'Paid', 'Refunded'];
const METHOD_LABELS = { upi: 'UPI', cod: 'Pay on delivery', shop: 'Pay at shop' };
const SOURCES = ['ig', 'gbp', 'shop', 'bag', 'direct'];
const IDEM_PATTERN = /^[A-Za-z0-9-]{16,64}$/;
const CALL_FIRST_MARK = 'CALL FIRST';
const DATE_TIME_FORMAT = 'd mmm yyyy, h:mm am/pm';
const MONEY_FORMAT = '"₹"#,##0';
const MAX_LINES = 50;

/* =====================================================================
 * Web app
 * ===================================================================== */

function doGet() {
  return json_({ ok: true, service: 'oneMore' });
}

function doPost(e) {
  let out;
  try {
    out = handleRequest_(e);
  } catch (err) {
    console.error('doPost failed: ' + (err && err.stack ? err.stack : err));
    out = fail_('server_error', String((err && err.message) || err));
  }
  return json_(out);
}

function handleRequest_(e) {
  let body;
  try {
    body = JSON.parse((e && e.postData && e.postData.contents) || '');
  } catch (err) {
    return fail_('bad_request', 'The request body must be JSON.');
  }
  if (!body || typeof body !== 'object') return fail_('bad_request', 'The request body must be a JSON object.');
  const expected = prop_('API_KEY');
  if (!expected || !safeEqual(body.key, expected)) return { ok: false, error: 'unauthorized', message: 'Wrong or missing key.' };
  const data = body.data && typeof body.data === 'object' ? body.data : {};
  switch (body.action) {
    case 'catalog':
      return actionCatalog_();
    case 'createOrder':
      return actionCreateOrder_(data);
    case 'attachUtr':
      return actionAttachUtr_(data);
    case 'notify':
      return actionNotify_(data);
    default:
      return fail_('bad_request', 'Unknown action.');
  }
}

function json_(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}

function fail_(error, message, details) {
  const out = { ok: false, error: error, message: message || '' };
  if (details !== undefined) out.details = details;
  return out;
}

/* =====================================================================
 * catalog - the whole Products file, used when the website is built
 * ===================================================================== */

function actionCatalog_() {
  const data = readProductsFile_(productsSpreadsheet_(), { info: true });
  return {
    ok: true,
    products: rowsAsObjects_(data.products.values),
    info: rowsAsObjects_(data.info.values),
    settings: settingsMap_(data.settings.values),
    delivery: rowsAsObjects_(data.delivery.values),
    generatedAt: new Date().toISOString(),
  };
}

/* =====================================================================
 * createOrder
 * ===================================================================== */

function actionCreateOrder_(data) {
  const req = parseOrderRequest_(data);
  if (!req.ok) return req;
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(20000)) return fail_('busy', 'Many orders are arriving right now. Please try again in a few seconds.');
  let out;
  try {
    out = createOrderLocked_(req.value);
  } finally {
    try {
      SpreadsheetApp.flush();
    } finally {
      lock.releaseLock();
    }
  }
  // The UPI ID to pay comes from the Payment tab of this private file at the moment of ordering.
  // If it can't be read, the order page falls back to upiId in shop.config.json.
  if (out.response.ok && out.response.order.method === 'upi') {
    try {
      const pay = paymentDetails_();
      if (pay.upiId) out.response.order.pay = { upiId: pay.upiId, upiName: pay.upiName };
    } catch (err) {
      console.error('Payment tab could not be read: ' + err);
    }
  }
  return out.response;
}

// Checks that need no spreadsheet: shape of the request.
function parseOrderRequest_(data) {
  const idemKey = typeof data.idemKey === 'string' ? data.idemKey.trim() : '';
  if (!IDEM_PATTERN.test(idemKey)) return fail_('bad_request', 'Please reload the page and try again.', { idemKey: 'missing or invalid' });
  if (!Array.isArray(data.items) || data.items.length < 1 || data.items.length > MAX_LINES) {
    return fail_('bad_request', 'Your cart is empty.', { items: 'no items' });
  }
  const merged = new Map(); // same ID twice in the cart -> one line, quantities added
  for (let i = 0; i < data.items.length; i++) {
    const it = data.items[i] || {};
    const id = text(it.id);
    const q = it.qty;
    const qty = typeof q === 'number' || (typeof q === 'string' && /^\d+$/.test(q.trim())) ? Number(q) : NaN;
    if (!id || id.length > 100) return fail_('bad_request', 'Something in your cart is not valid.', { items: 'missing item id' });
    if (!Number.isInteger(qty) || qty < 1) return fail_('bad_request', 'Quantities must be whole numbers.', { items: 'bad quantity for ' + id });
    merged.set(id, (merged.get(id) || 0) + qty);
  }
  const payment = String(data.payment || '');
  if (!METHOD_LABELS[payment]) return fail_('bad_request', 'Choose how you will pay.', { payment: 'must be upi, cod or shop' });
  const source = SOURCES.indexOf(String(data.source)) !== -1 ? String(data.source) : 'direct';
  return {
    ok: true,
    value: {
      idemKey: idemKey,
      items: Array.from(merged.entries()).map((e) => ({ id: e[0], qty: e[1] })),
      customer: data.customer && typeof data.customer === 'object' ? data.customer : {},
      payment: payment,
      source: source,
    },
  };
}

// Steps 1-7 of the contract. Runs inside the script lock.
// Returns { response, feedData } - feedData is set only when a new order was saved.
function createOrderLocked_(req) {
  const sheet = ordersSheet_();
  const values = sheet.getDataRange().getValues();
  const col = orderColumns_(values[0]);

  // 1. Same IdemKey already saved -> answer exactly as the first time.
  for (let r = 1; r < values.length; r++) {
    if (unguardText(text(values[r][col.idemKey])) === req.idemKey) {
      return { response: { ok: true, order: orderFromRow_(values[r], col) } };
    }
  }

  const data = readProductsFile_(productsSpreadsheet_(), { info: false });
  const model = modelFromData_(data, todayIST());
  const s = model.settings;

  // 2. Open for orders?
  if (s.AcceptingOrders !== 'Open') return { response: fail_('closed', s.ClosedMessage) };

  // Customer details (same rules as the checkout page).
  const cv = validateCustomerServer_(req.customer, s, model.delivery);
  const fieldErrors = Object.keys(cv.errors);
  if (fieldErrors.length) return { response: fail_('bad_request', cv.errors[fieldErrors[0]], cv.errors) };
  const c = cv.value;

  // 3. Items: exist and visible, sensible quantity, not marked Out of stock.
  const unavailable = req.items.filter((it) => {
    const v = model.byId.get(it.id);
    return !v || !v.visible;
  }).map((it) => it.id);
  if (unavailable.length) return { response: fail_('unavailable', 'Some items are no longer available.', unavailable) };
  const tooMany = req.items.filter((it) => it.qty > s.MaxQtyPerLine).map((it) => it.id);
  if (tooMany.length) {
    return { response: fail_('bad_request', 'You can order at most ' + s.MaxQtyPerLine + ' of each item.', { items: 'too many', ids: tooMany }) };
  }
  const soldOut = req.items.filter((it) => model.byId.get(it.id).soldOut).map((it) => it.id);
  if (soldOut.length) return { response: fail_('sold_out', 'Some items are out of stock.', soldOut) };

  // 4. Too many unpaid orders for this phone?
  let open = 0;
  let delivered = false;
  for (let r = 1; r < values.length; r++) {
    const row = values[r];
    if (cleanPhone(unguardText(text(row[col.phone]))) !== c.phone) continue;
    const st = normKey(row[col.status]);
    if (st === 'new' && normKey(row[col.payment]) === 'pending') open++;
    if (st === 'delivered') delivered = true;
  }
  if (open >= s.MaxOpenOrdersPerPhone) {
    return { response: fail_('too_many_open', 'You already have ' + open + ' unpaid orders with us. Please pay for them or message us on WhatsApp before ordering again.') };
  }

  // 6. Prices from the sheet, never from the browser.
  const lines = req.items.map((it) => {
    const v = model.byId.get(it.id);
    return { id: v.id, brand: v.brand, name: v.name, size: v.size, flavour: v.flavour, qty: it.qty, price: v.price, lineTotal: round2(v.price * it.qty) };
  });
  const subtotal = round2(lines.reduce((sum, l) => sum + l.lineTotal, 0));
  const deliveryFee = deliveryFeeFor({ subtotal: subtotal, fulfilment: c.fulfilment, area: c.area, settings: s, delivery: model.delivery });
  const total = round2(subtotal + deliveryFee);

  // 5. Payment method allowed?
  if (req.payment === 'shop' && c.fulfilment !== 'pickup') {
    return { response: fail_('bad_request', 'Pay at the shop is only for store pickup.', { payment: 'shop needs pickup' }) };
  }
  if (req.payment === 'cod' && c.fulfilment !== 'delivery') {
    return { response: fail_('bad_request', 'Pay on delivery is only for home delivery.', { payment: 'cod needs delivery' }) };
  }
  if (req.payment === 'cod' && total > s.CODMax) {
    return { response: fail_('bad_request', 'Pay on delivery is available up to ' + formatRupees(s.CODMax) + '. Please pay by UPI.', { payment: 'cod above CODMax' }) };
  }

  const callFirst = req.payment === 'cod' && total > s.CallFirstCODAbove && !delivered;

  // 7. Order number and new row. (No stock is counted: the supplier ships, the owner ticks Out of stock.)
  const props = PropertiesService.getScriptProperties();
  let seq = parseInt(props.getProperty('ORDER_SEQ'), 10);
  if (!Number.isFinite(seq)) seq = 1000;
  for (let r = 1; r < values.length; r++) {
    const m = /^ORD-(\d+)$/.exec(text(values[r][col.orderId]));
    if (m) seq = Math.max(seq, Number(m[1])); // never reuse a number, even if ORDER_SEQ was reset
  }
  seq += 1;
  props.setProperty('ORDER_SEQ', String(seq));

  const now = new Date(Math.floor(Date.now() / 1000) * 1000); // whole seconds, so it reads back identically
  const itemsText = lines.map((l) => {
    const label = [l.brand + ' ' + l.name, l.size, l.flavour].filter(Boolean).join(' – ');
    return l.qty + ' × ' + label + ' @ ' + formatRupees(l.price);
  });
  if (callFirst) itemsText.push(CALL_FIRST_MARK + ' – first pay-on-delivery order above ' + formatRupees(s.CallFirstCODAbove));

  const width = values[0].length;
  const row = new Array(width).fill('');
  const set = (field, v) => {
    row[col[field]] = v;
  };
  set('orderId', 'ORD-' + seq);
  set('created', now);
  set('status', 'New');
  set('payment', 'Pending');
  set('method', METHOD_LABELS[req.payment]);
  set('total', total);
  set('name', c.name);
  set('phone', c.phone);
  set('fulfilment', c.fulfilment === 'pickup' ? 'Pickup' : 'Delivery');
  set('area', c.area);
  set('pincode', c.pincode);
  set('address', c.address);
  set('landmark', c.landmark);
  set('items', itemsText.join('\n'));
  set('subtotal', subtotal);
  set('deliveryFee', deliveryFee);
  set('notes', c.notes);
  set('utr', '');
  set('utrFlag', '');
  set('source', req.source);
  set('updated', now);
  set('itemsJson', JSON.stringify(lines));
  set('idemKey', req.idemKey);
  for (let i = 0; i < row.length; i++) if (typeof row[i] === 'string') row[i] = guardText(row[i]);

  // Next row after the last order. Not values.length: checkbox columns make the
  // sheet's data range reach the bottom of the pre-formatted rows.
  let last = values.length;
  while (last > 1 && !text(values[last - 1][col.orderId])) last--;
  const newRow = last + 1;
  if (newRow > sheet.getMaxRows()) sheet.insertRowsAfter(sheet.getMaxRows(), 500);
  const range = sheet.getRange(newRow, 1, 1, width);
  const formats = range.getNumberFormats()[0];
  ORDER_TEXT_FIELDS.forEach((f) => {
    formats[col[f]] = '@';
  });
  formats[col.created] = DATE_TIME_FORMAT;
  formats[col.updated] = DATE_TIME_FORMAT;
  [col.total, col.subtotal, col.deliveryFee].forEach((i) => {
    formats[i] = MONEY_FORMAT;
  });
  range.setNumberFormats([formats]);
  range.setValues([row]);

  return { response: { ok: true, order: orderFromRow_(row, col) } };
}

// Server-side customer check: order.js rules + the Delivery tab's pincode list for the chosen area.
function validateCustomerServer_(input, settings, delivery) {
  const clean = {};
  ['name', 'phone', 'fulfilment', 'area', 'pincode', 'address', 'landmark', 'notes'].forEach((k) => {
    clean[k] = typeof input[k] === 'string' ? stripLeadingQuotes(input[k]) : input[k];
  });
  const out = validateCustomer(clean, settings);
  const c = out.value;
  if (c.fulfilment === 'delivery' && !out.errors.pincode) {
    const zone = delivery.find((d) => d.area === c.area);
    if (zone && zone.pincodes.length && zone.pincodes.indexOf(c.pincode) === -1) {
      out.errors.pincode = 'We do not deliver to pincode ' + c.pincode + ' in ' + c.area + '. Please check the area or pincode.';
    }
  }
  return out;
}

// Builds the order answer from a sheet row. Used for new orders AND repeats, so both are identical.
function orderFromRow_(row, col) {
  const t = (field) => unguardText(text(row[col[field]]));
  let lines;
  try {
    lines = JSON.parse(t('itemsJson') || '[]');
  } catch (err) {
    throw new Error('ItemsJSON of order ' + t('orderId') + ' cannot be read.');
  }
  const methodLabel = t('method');
  let method = 'upi';
  Object.keys(METHOD_LABELS).forEach((k) => {
    if (normKey(METHOD_LABELS[k]) === normKey(methodLabel)) method = k;
  });
  return {
    id: t('orderId'),
    created: isoSeconds_(row[col.created]),
    status: 'New',
    payment: 'Pending',
    method: method,
    lines: lines,
    subtotal: Number(row[col.subtotal]) || 0,
    deliveryFee: Number(row[col.deliveryFee]) || 0,
    total: Number(row[col.total]) || 0,
    customer: {
      name: t('name'),
      phone: t('phone'),
      fulfilment: normKey(t('fulfilment')) === 'pickup' ? 'pickup' : 'delivery',
      area: t('area'),
      pincode: t('pincode'),
      address: t('address'),
      landmark: t('landmark'),
      notes: t('notes'),
    },
    callFirst: t('items').indexOf(CALL_FIRST_MARK) !== -1,
  };
}

function isoSeconds_(v) {
  const d = v instanceof Date ? v : new Date(v);
  if (isNaN(d.getTime())) return '';
  return new Date(Math.round(d.getTime() / 1000) * 1000).toISOString();
}

/* =====================================================================
 * attachUtr
 * ===================================================================== */

function actionAttachUtr_(data) {
  const orderId = text(data.orderId);
  const token = text(data.token);
  const utr = String(data.utr === null || data.utr === undefined ? '' : data.utr).replace(/\s+/g, '');
  if (!orderId || !token) return fail_('not_found', 'Order not found.');
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(20000)) return fail_('busy', 'Please try again in a few seconds.');
  try {
    const sheet = ordersSheet_();
    const values = sheet.getDataRange().getValues();
    const col = orderColumns_(values[0]);
    let r = -1;
    for (let i = 1; i < values.length; i++) {
      if (unguardText(text(values[i][col.orderId])) === orderId) {
        r = i;
        break;
      }
    }
    if (r < 0 || !safeEqual(token, unguardText(text(values[r][col.idemKey])))) return fail_('not_found', 'Order not found.');
    if (!UTR_PATTERN.test(utr)) return fail_('bad_request', 'The UTR is the 12-digit number in your UPI app’s payment details.', { utr: '12 digits' });

    const others = [];
    for (let i = 1; i < values.length; i++) {
      if (i !== r && text(values[i][col.utr]) === utr) others.push(text(values[i][col.orderId]));
    }
    const oldFlag = text(values[r][col.utrFlag]);
    const flagLines = oldFlag.split('\n').filter((l) => l && l.indexOf('also on ') !== 0);
    if (others.length) flagLines.unshift('also on ' + others.join(', '));
    const newFlag = flagLines.join('\n');

    const rowNo = r + 1;
    sheet.getRange(rowNo, col.utr + 1).setNumberFormat('@').setValue(utr);
    if (newFlag !== oldFlag) sheet.getRange(rowNo, col.utrFlag + 1).setNumberFormat('@').setValue(guardText(newFlag));
    sheet.getRange(rowNo, col.updated + 1).setValue(new Date());
    SpreadsheetApp.flush();
    return { ok: true };
  } finally {
    lock.releaseLock();
  }
}

/* =====================================================================
 * notify - email the owner about a new order
 * ===================================================================== */

function actionNotify_(data) {
  const orderId = text(data.orderId);
  const sheet = ordersSheet_();
  const values = sheet.getDataRange().getValues();
  const col = orderColumns_(values[0]);
  let r = -1;
  for (let i = 1; i < values.length; i++) {
    if (orderId && unguardText(text(values[i][col.orderId])) === orderId) {
      r = i;
      break;
    }
  }
  if (r < 0) return fail_('not_found', 'Order not found.');

  const settings = normalizeSettings(settingsMap_(readSettingsValues_(productsSpreadsheet_())));
  const to = settings.AlertEmail;
  if (!to) return { ok: true, skipped: true, message: 'AlertEmail is blank in Settings.' };

  const row = values[r];
  const o = orderFromRow_(row, col);
  const subject = 'New order ' + o.id + ' · ' + formatRupees(o.total) + ' · ' + METHOD_LABELS[o.method] + (o.callFirst ? ' · CALL FIRST' : '');
  const body = orderEmailBody_(o, row, col, rowLink_(sheet, r + 1));
  const sent = sendMailSafely_(to, subject, body, ORDER_LABEL);
  return sent.ok ? { ok: true } : { ok: true, sent: false, message: sent.message };
}

function orderEmailBody_(o, row, col, link) {
  const c = o.customer;
  const out = [];
  out.push('New order ' + o.id + ' – ' + formatRupees(o.total));
  if (o.callFirst) out.push('*** CALL FIRST: first pay-on-delivery order above the limit – confirm by phone before packing. ***');
  out.push('');
  o.lines.forEach((l) => {
    out.push(l.qty + ' × ' + [l.brand + ' ' + l.name, l.size, l.flavour].filter(Boolean).join(' – ') + ' = ' + formatRupees(l.lineTotal));
  });
  out.push('');
  out.push('Subtotal: ' + formatRupees(o.subtotal));
  out.push(c.fulfilment === 'pickup' ? 'Delivery: store pickup' : 'Delivery: ' + (o.deliveryFee ? formatRupees(o.deliveryFee) : 'free'));
  out.push('Total: ' + formatRupees(o.total));
  const utr = text(row[col.utr]);
  out.push('Payment: ' + METHOD_LABELS[o.method] + ' – ' + text(row[col.payment]) + (utr ? ' (UTR ' + utr + ')' : ''));
  out.push('');
  out.push('Customer: ' + c.name);
  out.push('Phone: ' + c.phone);
  out.push('Call: tel:+91' + c.phone);
  out.push('WhatsApp: https://wa.me/91' + c.phone);
  if (c.fulfilment === 'pickup') out.push('Pickup from the shop');
  else {
    out.push('District: ' + c.area + (c.pincode ? ' – ' + c.pincode : ''));
    out.push('Address: ' + c.address);
    if (c.landmark) out.push('Landmark: ' + c.landmark);
  }
  if (c.notes) out.push('Notes: ' + c.notes);
  out.push('');
  out.push('Orders sheet: ' + link);
  return out.join('\n');
}

// Gmail label put on every new-order email and unpaid-order reminder.
const ORDER_LABEL = 'New order';

// Sends a plain-text email without ever throwing (daily email limits, bad address...).
// With a label, it is sent from Gmail and the thread gets that label in the script owner's Gmail.
function sendMailSafely_(to, subject, body, label) {
  try {
    if (MailApp.getRemainingDailyQuota() < 1) return { ok: false, message: 'Daily email limit reached.' };
    if (label) {
      try {
        const msg = GmailApp.createDraft(to, subject, body, { name: 'oneMore orders' }).send();
        const gLabel = GmailApp.getUserLabelByName(label) || GmailApp.createLabel(label);
        msg.getThread().addLabel(gLabel);
        return { ok: true };
      } catch (err) {
        console.error('Gmail label send failed, using plain email: ' + err);
      }
    }
    MailApp.sendEmail({ to: to, subject: subject, body: body, name: 'oneMore orders' });
    return { ok: true };
  } catch (err) {
    console.error('Email failed: ' + err);
    return { ok: false, message: 'Email could not be sent: ' + ((err && err.message) || err) };
  }
}

function rowLink_(sheet, rowNo) {
  return sheet.getParent().getUrl() + '#gid=' + sheet.getSheetId() + '&range=A' + rowNo;
}

/* =====================================================================
 * Spreadsheet helpers
 * ===================================================================== */

function prop_(key) {
  return PropertiesService.getScriptProperties().getProperty(key) || '';
}

function ordersSpreadsheet_() {
  let ss = null;
  try {
    ss = SpreadsheetApp.getActiveSpreadsheet();
  } catch (err) {
    ss = null;
  }
  if (ss) return ss;
  const id = prop_('ORDERS_SHEET_ID');
  if (!id) throw new Error('Orders spreadsheet not found. Run setupOrdersFile once.');
  return SpreadsheetApp.openById(id);
}

function ordersSheet_() {
  const sheet = findSheet_(ordersSpreadsheet_(), ORDERS_TAB);
  if (!sheet) throw new Error('The Orders tab is missing. Run setupOrdersFile.');
  return sheet;
}

function productsSpreadsheet_() {
  const id = prop_('PRODUCTS_SHEET_ID');
  if (!id) throw new Error('PRODUCTS_SHEET_ID is not set. Run setupProductsFile.');
  return SpreadsheetApp.openById(id);
}

// Find a tab by name, ignoring case and spaces.
function findSheet_(ss, name) {
  const exact = ss.getSheetByName(name);
  if (exact) return exact;
  const k = normKey(name);
  const all = ss.getSheets();
  for (let i = 0; i < all.length; i++) if (normKey(all[i].getName()) === k) return all[i];
  return null;
}

// Header row -> { field: 0-based column }. Throws a readable error when a column is missing.
function orderColumns_(header) {
  const col = {};
  const missing = [];
  ORDER_FIELDS.forEach((f) => {
    const i = findCol(header || [], [f[1]]);
    if (i < 0) missing.push(f[1]);
    col[f[0]] = i;
  });
  if (missing.length) throw new Error('The Orders tab is missing column(s): ' + missing.join(', ') + '. Run setupOrdersFile.');
  return col;
}

/**
 * Reads the Products file once: Products, Settings, Delivery (and Product info when opts.info).
 * Dates become YYYY-MM-DD text (times HH:mm), exactly what the catalog action returns.
 */
function readProductsFile_(ss, opts) {
  opts = opts || {};
  const tz = ss.getSpreadsheetTimeZone() || TZ;
  return {
    ss: ss,
    tz: tz,
    readAt: Date.now(),
    products: readTab_(ss, 'Products', tz, false, true),
    settings: readTab_(ss, 'Settings', tz, true, true),
    delivery: readTab_(ss, 'Delivery', tz, false, false),
    info: opts.info ? readTab_(ss, 'Product info', tz, false, false) : { sheet: null, values: [[]] },
  };
}

function readTab_(ss, name, tz, withDisplay, required) {
  const sheet = findSheet_(ss, name);
  if (!sheet) {
    if (required) throw new Error('The Products file has no "' + name + '" tab. Run setupProductsFile.');
    return { sheet: null, values: [[]] };
  }
  const range = sheet.getDataRange();
  const raw = range.getValues();
  const disp = withDisplay ? range.getDisplayValues() : null;
  return { sheet: sheet, values: raw.map((row, r) => row.map((v, c) => plainValue_(v, tz, disp ? disp[r][c] : null))) };
}

function readSettingsValues_(ss) {
  return readTab_(ss, 'Settings', ss.getSpreadsheetTimeZone() || TZ, true, true).values;
}

function plainValue_(v, tz, display) {
  if (v instanceof Date) {
    if (isNaN(v.getTime())) return '';
    if (v.getFullYear() < 1900) return display ? String(display) : Utilities.formatDate(v, tz, 'HH:mm'); // a time like 18:00
    return Utilities.formatDate(v, tz, 'yyyy-MM-dd');
  }
  return v;
}

// [[header...], [row...]] -> [{ header: value }], keyed by the exact header text.
function rowsAsObjects_(values) {
  if (!values || values.length < 2) return [];
  const header = values[0].map((h) => text(h));
  const out = [];
  for (let r = 1; r < values.length; r++) {
    const o = {};
    header.forEach((h, c) => {
      if (h) o[h] = values[r][c];
    });
    out.push(o);
  }
  return out;
}

function settingsCols_(header) {
  const keyCol = findCol(header || [], ['setting', 'key']);
  const valueCol = findCol(header || [], ['value']);
  return { keyCol: keyCol < 0 ? 0 : keyCol, valueCol: valueCol < 0 ? 1 : valueCol };
}

// Settings tab -> { Setting: Value }.
function settingsMap_(values) {
  const cols = settingsCols_(values[0]);
  const map = {};
  for (let r = 1; r < values.length; r++) {
    const k = text(values[r][cols.keyCol]);
    if (k) map[k] = values[r][cols.valueCol];
  }
  return map;
}

// Row number (1-based) of a setting, or 0.
function settingsRowOf_(values, key) {
  const cols = settingsCols_(values[0]);
  for (let r = 1; r < values.length; r++) if (normKey(values[r][cols.keyCol]) === normKey(key)) return r + 1;
  return 0;
}

function modelFromData_(data, today) {
  return buildCatalogModel({
    products: rowsAsObjects_(data.products.values),
    settings: settingsMap_(data.settings.values),
    delivery: rowsAsObjects_(data.delivery.values),
  }, today);
}

function nowText_() {
  return Utilities.formatDate(new Date(), TZ, 'd MMM yyyy HH:mm');
}
