// Cloudflare Worker (phase 2). Workers Builds runs "npm run build", then "npx wrangler deploy".
// Secrets (APPS_SCRIPT_URL, APPS_SCRIPT_KEY, REFRESH_KEY, optional TURNSTILE_SECRET) are set in the
// dashboard or with "npx wrangler secret put <NAME>", never here: this repository is public.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onemore",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
    // Pages and files are served straight from the assets; only the API runs code.
    "run_worker_first": ["/api/*"]
  },
  // Live price/stock feed pushed by the Google Sheet (/api/refresh) and read by /api/live.
  "kv_namespaces": [{ "binding": "LIVE", "id": "43e74debc66b4554b2dc67a136a6434f" }],
  "observability": { "enabled": true }
}
